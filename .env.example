# ==============================================================================
# REPOSENSE ENVIRONMENT CONFIGURATION
# ==============================================================================
# This file is separated into two sections:
# 1. BACKEND VARIABLES (Cloudflare Worker: reposense-api)
# 2. FRONTEND VARIABLES (Cloudflare Pages / Vercel: Next.js App)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND ENVIRONMENT VARIABLES (Cloudflare Worker / API)
# Cloudflare Dashboard -> Workers & Pages -> "reposense-api" -> Settings -> Variables and Secrets
# ------------------------------------------------------------------------------

# Database Connection (Neon PostgreSQL - Pooled connection recommended for serverless)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-sample.region.aws.neon.tech/neondb?sslmode=require"

# BYOK Encryption Key (32-byte hex or base64 string for AES-256-GCM encryption of GitHub/AI keys)
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Clerk Authentication (Backend secret for token verification)
CLERK_SECRET_KEY="sk_test_..."
CLERK_PUBLISHABLE_KEY="pk_test_..."

# Backend Cross-Origin & Workflow Settings
# Production: Set APP_URL to your Frontend URL (e.g., https://reposense.pages.dev)
APP_URL="http://localhost:3000"
# Production: Set API_URL to your deployed Worker URL (e.g., https://reposense-api.<subdomain>.workers.dev)
API_URL="http://localhost:8787"

# Emergency mode: OFF | READ_ONLY | MAINTENANCE
EMERGENCY_MODE="OFF"
MAX_GLOBAL_INDEXING_JOBS="25"

# Optional AI Fallback API Keys (Used only if user has not configured BYOK keys in Settings)
OPENAI_API_KEY=""
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""
DEEPSEEK_API_KEY=""
XAI_API_KEY=""
GROQ_API_KEY=""
GITHUB_TOKEN=""

# Optional Meeting Transcription & Media
ASSEMBLYAI_API_KEY=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_CLOUD_NAME=""


# ------------------------------------------------------------------------------
# 2. FRONTEND ENVIRONMENT VARIABLES (Next.js / Cloudflare Pages)
# Cloudflare Dashboard -> Workers & Pages -> Your Pages Project -> Settings -> Environment Variables
# ------------------------------------------------------------------------------

# Database Connection (Needed for Next.js SSR / tRPC queries)
# Note: Reuse the same Neon DATABASE_URL and DIRECT_URL as above
# DATABASE_URL=...
# DIRECT_URL=...

# Next.js Server & Client Keys
NODE_ENV="production"
# NEXT_PUBLIC_API_URL: Points to your deployed Cloudflare Worker API
# In dev: http://localhost:3000 or http://localhost:8787
# In prod: https://reposense-api.<your-subdomain>.workers.dev
NEXT_PUBLIC_API_URL="http://localhost:8787"

# NEXT_PUBLIC_APP_URL: Points to your frontend web app
# In dev: http://localhost:3000
# In prod: https://reposense.pages.dev (or your custom domain)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_LANDING_PAGE_URL="/"

# Clerk Frontend Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
# CLERK_SECRET_KEY is also required for Next.js server-side auth middleware
# CLERK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL="/sync-user"
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL="/sync-user"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/dashboard"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/dashboard"

# Optional Frontend Media
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
