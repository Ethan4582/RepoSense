# Next.js & Local Environment Variables (.env)
# Copy this file to .env and provide your local credentials

# Database (Neon PostgreSQL with pgvector)
DATABASE_URL=postgresql://user:pass@ep-xyz.aws.neon.tech/neondb?sslmode=require

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/sync-user

# Encryption Key for BYOK (32 bytes base64 or 64 hex chars)
ENCRYPTION_KEY=

# GitHub Personal Access Token (Optional fallback for public rate limits)
GITHUB_TOKEN=

# App & API Base URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000

# Cloudinary & AssemblyAI (Optional for Meetings)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
ASSEMBLYAI_API_KEY=
