// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider        = "prisma-client-js"
    previewFeatures = ["postgresqlExtensions", "driverAdapters"]
}

datasource db {
    provider   = "postgresql"
    url        = env("DATABASE_URL")
    directUrl  = env("DIRECT_URL")
    extensions = [vector]
}

enum Provider {
  OPENAI
  GEMINI
  ANTHROPIC
  META
  DEEPSEEK
  XAI
  GROQ
}

enum EmbeddingProvider {
  OPENAI
  GEMINI
}

enum KeyStatus {
  UNVERIFIED
  VALID
  INVALID
  QUOTA_EXHAUSTED
}

enum IndexingStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum IndexingStep {
  LOADING_REPO
  CHUNKING_AND_EMBEDDING
  PLANNING_WIKI
  GENERATING_PAGES
  FINALIZING
  DONE
}

model User {
  id                      String              @id @default(cuid())
  emailAddress            String              @unique
  firstName               String?
  lastName                String?
  imageUrl                String?
  defaultChatProvider     Provider            @default(OPENAI)
  defaultChatModel        String              @default("gpt-6.1-sol")
  defaultEmbeddingProvider EmbeddingProvider @default(OPENAI)
  preferences             Json?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  userToProjects          UserToProject[]
  questionsAsked          Question[]
  apiKeys                 ApiKey[]
  qaThreads               QaThread[]
}

model ApiKey {
  id              String      @id @default(cuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider        Provider
  encryptedKey    String
  iv              String
  keyLast4        String
  status          KeyStatus   @default(UNVERIFIED)
  lastVerifiedAt  DateTime?
  lastUsedAt      DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([userId, provider])
  @@index([userId])
}

model Project {
  id                  String             @id @default(cuid())
  name                String
  repoOwner           String
  repoName            String
  repoUrl             String
  encryptedGithubToken String?
  githubTokenIv       String?
  isPrivateRepo       Boolean            @default(false)
  isPublicWiki        Boolean            @default(true)
  chatProvider        Provider           @default(OPENAI)
  chatModel           String             @default("gpt-6.1-sol")
  embeddingProvider   EmbeddingProvider  @default(OPENAI)
  embeddingModel      String             @default("text-embedding-3-small")
  embeddingDimensions Int                @default(1536)
  repoSkeleton        Json?
  lastIndexedCommitSha String?
  lastIndexedAt       DateTime?
  deletedAt           DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  userToProjects      UserToProject[]
  sourceCodeEmbeddings SourceCodeEmbedding[]
  wikiPages           WikiPage[]
  qaThreads           QaThread[]
  savedQuestion       Question[]
  meetings            Meeting[]
  indexingJobs        IndexingJob[]

  @@index([repoOwner, repoName, isPublicWiki])
}

model WikiPage {
  id             String   @id @default(cuid())
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  slug           String
  title          String
  sectionTitle   String
  sectionOrder   Int
  pageOrder      Int
  content        String   @db.Text
  relevantFiles  String[]
  headings       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([projectId, slug])
  @@index([projectId, sectionOrder, pageOrder])
}

model SourceCodeEmbedding {
  id                     String                       @id @default(cuid())
  projectId              String
  project                Project                      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  filePath               String
  directory              String
  chunkIndex             Int
  startLine              Int
  endLine                Int
  chunkContent           String                       @db.Text
  fullFileContent        String?                      @db.Text
  embeddingOpenAI        Unsupported("vector(1536)")?
  embeddingGemini        Unsupported("vector(768)")?

  @@index([projectId, filePath])
  @@index([embeddingOpenAI(ops: raw("vector_cosine_ops"))], type: Hnsw)
  @@index([embeddingGemini(ops: raw("vector_cosine_ops"))], type: Hnsw)
}

model QaThread {
  id        String      @id @default(cuid())
  projectId String
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  messages  QaMessage[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([projectId, userId])
}

model QaMessage {
  id           String   @id @default(cuid())
  threadId     String
  thread       QaThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  role         String
  content      String   @db.Text
  scannedFiles Json?
  modelUsed    String?
  createdAt    DateTime @default(now())

  @@index([threadId, createdAt])
}

model IndexingJob {
  id                       String         @id @default(cuid())
  projectId                String
  project                  Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status                   IndexingStatus @default(QUEUED)
  currentStep              IndexingStep   @default(LOADING_REPO)
  totalFiles               Int            @default(0)
  processedFiles           Int            @default(0)
  totalWikiPages           Int            @default(0)
  completedWikiPages       Int            @default(0)
  estimatedSecondsRemaining Int?
  currentDetail            String?
  errorCode                String?
  errorMessage             String?
  startedAt                DateTime       @default(now())
  finishedAt               DateTime?

  @@index([projectId])
  @@index([status])
}

model UserToProject {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  projectId String
  user      User     @relation(fields: [userId], references: [id])
  project   Project  @relation(fields: [projectId], references: [id])

  @@unique([userId, projectId])
}

model Meeting {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  name       String
  meetingUrl String // cloudinary url
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id])
  status     MeetingStatus @default(PROCESSING)
  issues     Issue[]
}

enum MeetingStatus {
  PROCESSING
  COMPLETED
}

model Issue {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  gist      String
  headline  String
  summary   String
  start     String
  end       String
  meetingId String
  meeting   Meeting  @relation(fields: [meetingId], references: [id])
}

model Question {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  question      String
  answers       String
  fileReference Json?
  isPinned      Boolean  @default(false)
  isBookmarked  Boolean  @default(false)
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id])
  userId        String
  user          User     @relation(fields: [userId], references: [id])
}
