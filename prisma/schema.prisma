// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions", "driverAdapters"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [vector]
}

enum Provider {
  OPENAI
  GEMINI
  ANTHROPIC
  META
  DEEPSEEK
  XAI
  GROQ
}

enum EmbeddingProvider {
  OPENAI
  GEMINI
}

enum KeyStatus {
  UNVERIFIED
  VALID
  INVALID
  QUOTA_EXHAUSTED
}

enum IndexingStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum IndexingStep {
  LOADING_REPO
  CHUNKING_AND_EMBEDDING
  PLANNING_WIKI
  GENERATING_PAGES
  FINALIZING
  DONE
}

enum ProjectRole {
  OWNER
  EDITOR
  CONTRIBUTOR
  VIEWER
}

enum RevisionStatus {
  PUBLISHED
  PENDING
}

enum IndexingTrigger {
  MANUAL
  INITIAL
  MERGE
  PUSH
}

enum NotificationType {
  INDEXING
  WIKI_UPDATED
  REVIEW_REQUIRED
  ACCESS
  SECURITY
}

model User {
  id                       String              @id @default(cuid())
  emailAddress             String              @unique
  firstName                String?
  lastName                 String?
  imageUrl                 String?
  defaultChatProvider      Provider            @default(OPENAI)
  defaultChatModel         String              @default("gpt-6.1-sol")
  defaultEmbeddingProvider EmbeddingProvider   @default(OPENAI)
  preferences              Json?
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt
  userToProjects           UserToProject[]
  questionsAsked           Question[]
  apiKeys                  ApiKey[]
  qaThreads                QaThread[]
  ownedProjects            Project[]           @relation("ProjectOwner")
  projectInvitations       ProjectInvitation[] @relation("InvitationCreator")
  wikiPageRevisions        WikiPageRevision[]
  projectAuditEvents       ProjectAuditEvent[]
  notifications            Notification[]
}

model ApiKey {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider       Provider
  encryptedKey   String
  iv             String
  keyLast4       String
  status         KeyStatus @default(UNVERIFIED)
  lastVerifiedAt DateTime?
  lastUsedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([userId, provider])
  @@index([userId])
}

model Project {
  id                      String                @id @default(cuid())
  canonicalRepoKey        String?               @unique
  githubRepositoryId      String?               @unique
  ownerId                 String
  owner                   User                  @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  name                    String
  repoOwner               String
  repoName                String
  repoUrl                 String
  encryptedGithubToken    String?
  githubTokenIv           String?
  isPrivateRepo           Boolean               @default(false)
  isPublicWiki            Boolean               @default(true)
  chatProvider            Provider              @default(OPENAI)
  chatModel               String                @default("gpt-6.1-sol")
  embeddingProvider       EmbeddingProvider     @default(OPENAI)
  embeddingModel          String                @default("text-embedding-3-small")
  embeddingDimensions     Int                   @default(1536)
  repoSkeleton            Json?
  defaultBranch           String?
  lastIndexedBranch       String?
  lastIndexedBranchKind   String?
  lastIndexedPullRequest  Int?
  lastIndexedCommitSha    String?
  lastIndexedAt           DateTime?
  automaticUpdatesEnabled Boolean               @default(false)
  directEditNotifications Boolean               @default(true)
  deletedAt               DateTime?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  userToProjects          UserToProject[]
  sourceCodeEmbeddings    SourceCodeEmbedding[]
  wikiPages               WikiPage[]
  qaThreads               QaThread[]
  savedQuestion           Question[]
  meetings                Meeting[]
  indexingJobs            IndexingJob[]
  invitations             ProjectInvitation[]
  auditEvents             ProjectAuditEvent[]

  @@index([repoOwner, repoName, isPublicWiki])
}

model WikiPage {
  id            String             @id @default(cuid())
  projectId     String
  project       Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  branch        String             @default("main")
  commitSha     String?
  slug          String
  title         String
  sectionTitle  String
  sectionOrder  Int
  pageOrder     Int
  content       String             @db.Text
  relevantFiles String[]
  headings      Json?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  revisions     WikiPageRevision[]

  @@unique([projectId, branch, slug])
  @@index([projectId, branch, sectionOrder, pageOrder])
}

model SourceCodeEmbedding {
  id              String                       @id @default(cuid())
  projectId       String
  project         Project                      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  branch          String                       @default("main")
  commitSha       String?
  filePath        String
  directory       String
  chunkIndex      Int
  startLine       Int
  endLine         Int
  chunkContent    String                       @db.Text
  fullFileContent String?                      @db.Text
  embeddingOpenAI Unsupported("vector(1536)")?
  embeddingGemini Unsupported("vector(768)")?

  @@unique([projectId, branch, filePath, chunkIndex])
  @@index([projectId, branch, filePath])
}

model QaThread {
  id        String      @id @default(cuid())
  projectId String
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch    String      @default("main")
  title     String
  messages  QaMessage[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([projectId, branch, userId])
}

model QaMessage {
  id           String   @id @default(cuid())
  threadId     String
  thread       QaThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  role         String
  content      String   @db.Text
  scannedFiles Json?
  modelUsed    String?
  createdAt    DateTime @default(now())

  @@index([threadId, createdAt])
}

model IndexingJob {
  id                        String          @id @default(cuid())
  projectId                 String
  project                   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  branch                    String          @default("main")
  branchKind                String          @default("MAIN")
  pullRequestNumber         Int?
  commitSha                 String?
  baseCommitSha             String?
  trigger                   IndexingTrigger @default(MANUAL)
  requestedByUserId         String?
  priority                  Int             @default(100)
  availableAt               DateTime        @default(now())
  attemptCount              Int             @default(0)
  maxAttempts               Int             @default(3)
  leaseOwner                String?
  leaseExpiresAt            DateTime?
  githubDeliveryId          String?
  githubRequestCount        Int             @default(0)
  processedChunks           Int             @default(0)
  estimatedProviderTokens   Int             @default(0)
  status                    IndexingStatus  @default(QUEUED)
  currentStep               IndexingStep    @default(LOADING_REPO)
  totalFiles                Int             @default(0)
  processedFiles            Int             @default(0)
  totalWikiPages            Int             @default(0)
  completedWikiPages        Int             @default(0)
  estimatedSecondsRemaining Int?
  currentDetail             String?
  errorCode                 String?
  errorMessage              String?
  startedAt                 DateTime        @default(now())
  finishedAt                DateTime?

  @@unique([projectId, commitSha, trigger])
  @@index([projectId])
  @@index([status])
  @@index([status, availableAt, priority])
}

model UserToProject {
  id        String      @id @default(cuid())
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  userId    String
  projectId String
  role      ProjectRole @default(VIEWER)
  user      User        @relation(fields: [userId], references: [id])
  project   Project     @relation(fields: [projectId], references: [id])

  @@unique([userId, projectId])
}

model ProjectInvitation {
  id           String      @id @default(cuid())
  projectId    String
  project      Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdById  String
  createdBy    User        @relation("InvitationCreator", fields: [createdById], references: [id], onDelete: Cascade)
  tokenHash    String      @unique
  role         ProjectRole
  expiresAt    DateTime
  acceptedAt   DateTime?
  acceptedById String?
  createdAt    DateTime    @default(now())

  @@index([projectId, expiresAt])
}

model WikiPageRevision {
  id              String         @id @default(cuid())
  pageId          String
  page            WikiPage       @relation(fields: [pageId], references: [id], onDelete: Cascade)
  actorId         String?
  actor           User?          @relation(fields: [actorId], references: [id], onDelete: SetNull)
  status          RevisionStatus @default(PUBLISHED)
  title           String
  sectionTitle    String
  content         String         @db.Text
  relevantFiles   String[]
  headings        Json?
  additions       Int            @default(0)
  deletions       Int            @default(0)
  sourceCommitSha String?
  createdAt       DateTime       @default(now())

  @@unique([pageId, sourceCommitSha, status])
  @@index([pageId, createdAt])
  @@index([pageId, status])
}

model ProjectAuditEvent {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([projectId, createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String?
  dedupeKey String?          @unique
  type      NotificationType
  title     String
  message   String
  href      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt, createdAt])
}

model GithubWebhookDelivery {
  id           String   @id
  event        String
  repositoryId String?
  receivedAt   DateTime @default(now())

  @@index([receivedAt])
}

model Meeting {
  id         String        @id @default(cuid())
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  name       String
  meetingUrl String // cloudinary url
  projectId  String
  project    Project       @relation(fields: [projectId], references: [id])
  status     MeetingStatus @default(PROCESSING)
  issues     Issue[]
}

enum MeetingStatus {
  PROCESSING
  COMPLETED
}

model Issue {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  gist      String
  headline  String
  summary   String
  start     String
  end       String
  meetingId String
  meeting   Meeting  @relation(fields: [meetingId], references: [id])
}

model Question {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  question      String
  answers       String
  fileReference Json?
  isPinned      Boolean  @default(false)
  isBookmarked  Boolean  @default(false)
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id])
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  branch        String   @default("main")
}
